setup {
    name: "Hollow box",
    units: "mm",
    coordinate_system: "Z-up"
}

parameters {
    width: 100.0,
    depth: 50.0,
    height: 30.0,
    wall_thickness: 3.0
}

def HollowBox = 
    let box = Box(
        width: $width,
        depth: $depth,
        height: $height) in 
    let cutout = Box(
        width: $width - 2.0*$wall_thickness,
        depth: $depth - 2.0*$wall_thickness,
        height: $height - $wall_thickness) in 
    Component(
        solid: join(
            frame: box,
            placed: cutout,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.corner.offset(
                        x: $wall_thickness,
                        y: $wall_thickness,
                        z: $wall_thickness),
                    placed: placed.corner),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame - placed
        ),
        expose: coords => {
            origin: Vector(
                coords: coords,
                x: $width / 2.0,
                y: $depth / 2.0,
                z: $height / 2.0)
        }
    )

export(HollowBox)
