setup {
    units: "mm",
    coordinate_system: "Z-up"
}

// Body, cabin, and wheel are separate solids. Joins seat them on each other.
def pi = 3.14159265359
def body_w = 100.0
def body_d = 200.0
def body_h = 20.0
def cabin_w = 80.0
def cabin_d = 70.0
def cabin_h = 32.0
def wheel_r = 12.0
def wheel_w = 14.0
def track = body_w - wheel_w
def ride = 8.0
def nose = 42.0
def wheelbase = 120.0
def roof_overlap = 8.0

def front_at = Vector(x: wheel_w / 2.0, y: body_d - nose, z: wheel_r - ride)
def rear_at = Vector(x: wheel_w / 2.0, y: body_d - nose - wheelbase, z: wheel_r - ride)

def Body = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: body_w, min_v: u => 0.0, max_v: u => body_d, formula: u => v => Vector(x: u, y: v, z: 0.0)),
        Surface2D(max_u: body_w, min_v: u => 0.0, max_v: u => body_d, formula: u => v => Vector(x: u, y: v, z: body_h)),
        Surface2D(max_u: body_w, min_v: u => 0.0, max_v: u => body_h, formula: u => v => Vector(x: u, y: 0.0, z: v)),
        Surface2D(max_u: body_w, min_v: u => 0.0, max_v: u => body_h, formula: u => v => Vector(x: u, y: body_d, z: v)),
        Surface2D(max_u: body_d, min_v: u => 0.0, max_v: u => body_h, formula: u => v => Vector(x: 0.0, y: u, z: v)),
        Surface2D(max_u: body_d, min_v: u => 0.0, max_v: u => body_h, formula: u => v => Vector(x: body_w, y: u, z: v))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        top: Vector(x: body_w / 2.0, y: body_d / 2.0, z: body_h)
    }
)

def Cabin = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: cabin_w, min_v: u => 0.0, max_v: u => cabin_d, formula: u => v => Vector(x: u, y: v, z: 0.0)),
        Surface2D(max_u: cabin_w, min_v: u => 0.0, max_v: u => cabin_d, formula: u => v => Vector(x: u, y: v, z: cabin_h)),
        Surface2D(max_u: cabin_w, min_v: u => 0.0, max_v: u => cabin_h, formula: u => v => Vector(x: u, y: 0.0, z: v)),
        Surface2D(max_u: cabin_w, min_v: u => 0.0, max_v: u => cabin_h, formula: u => v => Vector(x: u, y: cabin_d, z: v)),
        Surface2D(max_u: cabin_d, min_v: u => 0.0, max_v: u => cabin_h, formula: u => v => Vector(x: 0.0, y: u, z: v)),
        Surface2D(max_u: cabin_d, min_v: u => 0.0, max_v: u => cabin_h, formula: u => v => Vector(x: cabin_w, y: u, z: v))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        bottom: Vector(x: cabin_w / 2.0, y: cabin_d / 2.0, z: 0.0)
    }
)

def half = wheel_w / 2.0
def Wheel = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => wheel_w, formula: u => v => Vector(x: 0.0 - half + v, y: wheel_r * cos(rad: u), z: wheel_r * sin(rad: u))),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => wheel_r, formula: u => v => Vector(x: 0.0 - half, y: v * cos(rad: u), z: v * sin(rad: u))),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => wheel_r, formula: u => v => Vector(x: half, y: v * cos(rad: u), z: v * sin(rad: u)))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Hull = Component(
    solid: join(frame: Body, placed: Cabin, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.top + Vector(x: 0.0, y: 0.0, z: 0.0 - roof_overlap), placed: placed.bottom),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Axle = Component(
    solid: join(frame: Wheel, placed: Wheel, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + Vector(x: track, y: 0.0, z: 0.0), placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def WithFront = Component(
    solid: join(frame: Hull, placed: Axle, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + front_at, placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Car = Component(
    solid: join(frame: WithFront, placed: Axle, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + rear_at, placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {}
)

export(Car)
