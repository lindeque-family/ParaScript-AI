setup {
    units: "mm",
    coordinate_system: "Z-up"
}

// Each solid is its own part. Joins say how the placed part sits in the frame part.
def pi = 3.14159265359
def base_w = 80.0
def base_d = 40.0
def base_h = 8.0
def block_w = 14.0
def block_d = 30.0
def block_h = 9.0
def cable_r = 2.5
def cable_span = 32.0
def clip_pitch = 20.0
def clip_gap = clip_pitch - block_w
def clip_row = block_w * 3.0 + clip_gap * 2.0
def clip_margin = (base_w - clip_row) / 2.0
def bite = 1.0
def shaker_r = 16.0
def bore_r = 13.0
def cup_h = 55.0
def bore_h = 54.0
def floor_t = 2.0
def cap_r = 17.0
def cap_h = 10.0
def lip = 3.0
def hole_r = 1.3
def vent_h = 6.0
def vent_z = 6.0
def vent_pitch = 6.0
def clearance = 60.0

def clip_shift = Vector(x: clip_pitch, y: 0.0, z: 0.0)
def clip_end = Vector(x: clip_pitch * 2.0, y: 0.0, z: 0.0)

def Base = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: base_w, min_v: u => 0.0, max_v: u => base_d, formula: u => v => Vector(x: u, y: v, z: 0.0)),
        Surface2D(max_u: base_w, min_v: u => 0.0, max_v: u => base_d, formula: u => v => Vector(x: u, y: v, z: base_h)),
        Surface2D(max_u: base_w, min_v: u => 0.0, max_v: u => base_h, formula: u => v => Vector(x: u, y: 0.0, z: v)),
        Surface2D(max_u: base_w, min_v: u => 0.0, max_v: u => base_h, formula: u => v => Vector(x: u, y: base_d, z: v)),
        Surface2D(max_u: base_d, min_v: u => 0.0, max_v: u => base_h, formula: u => v => Vector(x: 0.0, y: u, z: v)),
        Surface2D(max_u: base_d, min_v: u => 0.0, max_v: u => base_h, formula: u => v => Vector(x: base_w, y: u, z: v))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        seat: Vector(x: clip_margin, y: base_d / 2.0, z: base_h)
    }
)

def Block = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: block_w, min_v: u => 0.0, max_v: u => block_d, formula: u => v => Vector(x: u, y: v, z: 0.0)),
        Surface2D(max_u: block_w, min_v: u => 0.0, max_v: u => block_d, formula: u => v => Vector(x: u, y: v, z: block_h)),
        Surface2D(max_u: block_w, min_v: u => 0.0, max_v: u => block_h, formula: u => v => Vector(x: u, y: 0.0, z: v)),
        Surface2D(max_u: block_w, min_v: u => 0.0, max_v: u => block_h, formula: u => v => Vector(x: u, y: block_d, z: v)),
        Surface2D(max_u: block_d, min_v: u => 0.0, max_v: u => block_h, formula: u => v => Vector(x: 0.0, y: u, z: v)),
        Surface2D(max_u: block_d, min_v: u => 0.0, max_v: u => block_h, formula: u => v => Vector(x: block_w, y: u, z: v))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: block_w / 2.0, y: block_d / 2.0, z: block_h / 2.0)
    }
)

def half = cable_span / 2.0
def Cable = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cable_span, formula: u => v => Vector(x: cable_r * cos(rad: u), y: 0.0 - half + v, z: cable_r * sin(rad: u))),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cable_r, formula: u => v => Vector(x: v * cos(rad: u), y: 0.0 - half, z: v * sin(rad: u))),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cable_r, formula: u => v => Vector(x: v * cos(rad: u), y: half, z: v * sin(rad: u)))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Clip = Component(
    solid: join(frame: Block, placed: Cable, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at, placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame - placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: block_w / 2.0, y: block_d / 2.0, z: block_h / 2.0),
        origin: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def ClipPair = Component(
    solid: join(frame: Clip, placed: Clip, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + clip_shift, placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Clips = Component(
    solid: join(frame: ClipPair, placed: Clip, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + clip_end, placed: placed.origin),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: block_d / 2.0, z: 0.0)
    }
)

def Organizer = Component(
    solid: join(frame: Base, placed: Clips, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.seat + Vector(x: 0.0, y: 0.0, z: 0.0 - bite), placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        seat: Vector(x: base_w + shaker_r + clearance, y: base_d / 2.0, z: 0.0)
    }
)

def ShakerOuter = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cup_h, formula: u => v => Vector(x: shaker_r * cos(rad: u), y: shaker_r * sin(rad: u), z: v)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => shaker_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: 0.0)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => shaker_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: cup_h))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0),
        top: Vector(x: 0.0, y: 0.0, z: cup_h)
    }
)

def ShakerBore = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => bore_h, formula: u => v => Vector(x: bore_r * cos(rad: u), y: bore_r * sin(rad: u), z: v)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => bore_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: 0.0)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => bore_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: bore_h))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Cup = Component(
    solid: join(frame: ShakerOuter, placed: ShakerBore, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + Vector(x: 0.0, y: 0.0, z: floor_t), placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame - placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        top: Vector(x: 0.0, y: 0.0, z: cup_h),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def CapShell = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cap_h, formula: u => v => Vector(x: cap_r * cos(rad: u), y: cap_r * sin(rad: u), z: v)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cap_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: 0.0)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => cap_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: cap_h))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0),
        bottom: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Vent = Component(
    solid: Solid3D(faces: [
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => vent_h, formula: u => v => Vector(x: hole_r * cos(rad: u), y: hole_r * sin(rad: u), z: v)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => hole_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: 0.0)),
        Surface2D(max_u: 2.0 * pi, min_v: u => 0.0, max_v: u => hole_r, formula: u => v => Vector(x: v * cos(rad: u), y: v * sin(rad: u), z: vent_h))
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Vents = Component(
    solid: join(frame: Vent, placed: Vent, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + Vector(x: vent_pitch, y: 0.0, z: 0.0), placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Cap = Component(
    solid: join(frame: CapShell, placed: Vents, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.at + Vector(x: 0.0, y: 0.0, z: vent_z), placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame - placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        bottom: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def Shaker = Component(
    solid: join(frame: Cup, placed: Cap, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.top + Vector(x: 0.0, y: 0.0, z: 0.0 - lip), placed: placed.bottom),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        at: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def DeskSet = Component(
    solid: join(frame: Organizer, placed: Shaker, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.seat, placed: placed.at),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {}
)

export(DeskSet)
