setup {
    units: "mm",
    coordinate_system: "Z-up"
}

parameters {
    base: {
        width: 80.0,
        depth: 40.0,
        height: 8.0
    },
    clip: {
        width: 14.0,
        depth: 30.0,
        height: 9.0,
        pitch: 20.0,
        bite: 1.0
    },
    cable: {
        radius: 2.5,
        span: 32.0
    },
    shaker: {
        clearance: 60.0,
        cup: {
            radius: 16.0,
            height: 55.0,
            bore: 13.0,
            bore_height: 54.0,
            floor: 2.0
        },
        cap: {
            radius: 17.0,
            height: 10.0,
            lip: 3.0
        },
        vent: {
            radius: 1.3,
            height: 6.0,
            from_bottom: 6.0,
            pitch: 6.0
        }
    }
}

def pi = 3.14159265359

def Box = width => depth => height =>
    Component(
        solid: coords =>
            let top = Surface2D(
                max_u: width,
                min_v: u => 0.0,
                max_v: u => depth,
                formula: u => v => Vector(coords: coords, x: u, y: v, z: height)) in
            let bottom = Surface2D(
                max_u: width,
                min_v: u => 0.0,
                max_v: u => depth,
                formula: u => v => Vector(coords: coords, x: u, y: v, z: 0.0)) in
            let front = Surface2D(
                max_u: width,
                min_v: u => 0.0,
                max_v: u => height,
                formula: u => v => Vector(coords: coords, x: u, y: depth, z: v)) in
            let back = Surface2D(
                max_u: width,
                min_v: u => 0.0,
                max_v: u => height,
                formula: u => v => Vector(coords: coords, x: u, y: 0.0, z: v)) in
            let left = Surface2D(
                max_u: depth,
                min_v: u => 0.0,
                max_v: u => height,
                formula: u => v => Vector(coords: coords, x: 0.0, y: u, z: v)) in
            let right = Surface2D(
                max_u: depth,
                min_v: u => 0.0,
                max_v: u => height,
                formula: u => v => Vector(coords: coords, x: width, y: u, z: v)) in
            Solid3D(faces: [
                    bottom,
                    top,
                    back,
                    front,
                    left,
                    right
                ]),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            corner: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0),
            bottom: Vector(coords: coords, x: width / 2.0, y: depth / 2.0, z: 0.0),
            top: Vector(coords: coords, x: width / 2.0, y: depth / 2.0, z: height)
        }
    )

def Cylinder = radius => height =>
    Component(
        solid: coords =>
            let Disk = z => Surface2D(
                max_u: 2.0 * pi,
                min_v: u => 0.0,
                max_v: u => radius,
                formula: u => v => Vector(coords: coords,
                    x: v * cos(rad: u),
                    y: v * sin(rad: u),
                    z: z)) in
            let wall = Surface2D(
                max_u: 2.0 * pi,
                min_v: u => 0.0,
                max_v: u => height,
                formula: u => v => Vector(coords: coords,
                    x: radius * cos(rad: u),
                    y: radius * sin(rad: u),
                    z: v)) in
            let bottom = Disk(z: 0.0) in
            let top = Disk(z: height) in
            Solid3D(faces: [
                    wall,
                    bottom,
                    top
                ]),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            bottom: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0),
            top: Vector(coords: coords, x: 0.0, y: 0.0, z: height)
        }
    )

def Clip =
    let block = Box(
        width: $clip.width,
        depth: $clip.depth,
        height: $clip.height) in
    let half = $cable.span / 2.0 in
    let cable = Component(
        solid: coords =>
            let wall = Surface2D(
                max_u: 2.0 * pi,
                min_v: u => 0.0,
                max_v: u => $cable.span,
                formula: u => v => Vector(coords: coords,
                    x: $cable.radius * cos(rad: u),
                    y: 0.0 - half + v,
                    z: $cable.radius * sin(rad: u))) in
            let back = Surface2D(
                max_u: 2.0 * pi,
                min_v: u => 0.0,
                max_v: u => $cable.radius,
                formula: u => v => Vector(coords: coords,
                    x: v * cos(rad: u),
                    y: 0.0 - half,
                    z: v * sin(rad: u))) in
            let front = Surface2D(
                max_u: 2.0 * pi,
                min_v: u => 0.0,
                max_v: u => $cable.radius,
                formula: u => v => Vector(coords: coords,
                    x: v * cos(rad: u),
                    y: half,
                    z: v * sin(rad: u))) in
            Solid3D(faces: [
                    wall,
                    back,
                    front
                ]),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            at: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    Component(
        solid: join(
            frame: block,
            placed: cable,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.corner.offset(
                        x: $clip.width / 2.0,
                        y: $clip.depth / 2.0,
                        z: $clip.height / 2.0),
                    placed: placed.at),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame - placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            corner: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0),
            at: Vector(coords: coords,
                x: $clip.width / 2.0,
                y: $clip.depth / 2.0,
                z: $clip.height / 2.0)
        }
    )

def Shaker =
    let outer = Cylinder(
        radius: $shaker.cup.radius,
        height: $shaker.cup.height) in
    let bore = Cylinder(
        radius: $shaker.cup.bore,
        height: $shaker.cup.bore_height) in
    let cup = Component(
        solid: join(
            frame: outer,
            placed: bore,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.bottom.offset(
                        x: 0.0,
                        y: 0.0,
                        z: $shaker.cup.floor),
                    placed: placed.bottom),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame - placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            top: Vector(coords: coords, x: 0.0, y: 0.0, z: $shaker.cup.height)
        }
    ) in
    let shell = Cylinder(
        radius: $shaker.cap.radius,
        height: $shaker.cap.height) in
    let vent = Cylinder(
        radius: $shaker.vent.radius,
        height: $shaker.vent.height) in
    let vents = Component(
        solid: join(
            frame: vent,
            placed: vent,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.bottom.offset(
                        x: $shaker.vent.pitch,
                        y: 0.0,
                        z: 0.0),
                    placed: placed.bottom),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            at: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    let cap = Component(
        solid: join(
            frame: shell,
            placed: vents,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.bottom.offset(
                        x: 0.0,
                        y: 0.0,
                        z: $shaker.vent.from_bottom),
                    placed: placed.at),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame - placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            bottom: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    Component(
        solid: join(
            frame: cup,
            placed: cap,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.top.offset(
                        x: 0.0,
                        y: 0.0,
                        z: 0.0 - $shaker.cap.lip),
                    placed: placed.bottom),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            at: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    )

def DeskSet =
    let gap = $clip.pitch - $clip.width in
    let row = $clip.width * 3.0 + gap * 2.0 in
    let margin = ($base.width - row) / 2.0 in
    let base = Box(
        width: $base.width,
        depth: $base.depth,
        height: $base.height) in
    let pair = Component(
        solid: join(
            frame: Clip,
            placed: Clip,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.at.offset(
                        x: $clip.pitch,
                        y: 0.0,
                        z: 0.0),
                    placed: placed.at),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            corner: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    let clips = Component(
        solid: join(
            frame: pair,
            placed: Clip,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.corner.offset(
                        x: $clip.pitch * 2.0,
                        y: 0.0,
                        z: 0.0),
                    placed: placed.corner),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            corner: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    let organizer = Component(
        solid: join(
            frame: base,
            placed: clips,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.corner.offset(
                        x: margin,
                        y: $base.depth / 2.0,
                        z: $base.height - $clip.bite),
                    placed: placed.corner.offset(
                        x: 0.0,
                        y: $clip.depth / 2.0,
                        z: 0.0)),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {
            up: Vector(coords: coords, x: 0.0, y: 0.0, z: 1.0),
            right: Vector(coords: coords, x: 1.0, y: 0.0, z: 0.0),
            corner: Vector(coords: coords, x: 0.0, y: 0.0, z: 0.0)
        }
    ) in
    Component(
        solid: join(
            frame: organizer,
            placed: Shaker,
            using: frame => placed => align(
                planar: meet(
                    frame: frame.up,
                    placed: placed.up),
                translation: meet(
                    frame: frame.corner.offset(
                        x: $base.width + $shaker.cup.radius + $shaker.clearance,
                        y: $base.depth / 2.0,
                        z: 0.0),
                    placed: placed.at),
                rotation: meet(
                    frame: frame.right,
                    placed: placed.right)
            ),
            combine: frame => placed => frame + placed
        ),
        expose: coords => {}
    )

export(DeskSet)
