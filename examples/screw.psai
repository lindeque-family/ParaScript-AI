setup {
    units: "mm",
    coordinate_system: "Z-up"
}

// ISO 4762 M3 cap-head screw. The shaft is its own solid and hangs below the head.
def pi = 3.14159265359
def length = 16.0
def head_diameter = 5.5
def head_height = 3.0
def thread_radius = 1.5
def overlap = 0.2

def span = length + overlap
def Shaft = Component(
    solid: Solid3D(faces: [
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => span,
            formula: u => v => Vector(
                x: thread_radius * cos(rad: u),
                y: thread_radius * sin(rad: u),
                z: v
            )
        ),
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => thread_radius,
            formula: u => v => Vector(
                x: v * cos(rad: u),
                y: v * sin(rad: u),
                z: 0.0
            )
        ),
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => thread_radius,
            formula: u => v => Vector(
                x: v * cos(rad: u),
                y: v * sin(rad: u),
                z: span
            )
        )
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        top: Vector(x: 0.0, y: 0.0, z: span)
    }
)

def radius = head_diameter / 2.0
def Head = Component(
    solid: Solid3D(faces: [
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => head_height,
            formula: u => v => Vector(
                x: radius * cos(rad: u),
                y: radius * sin(rad: u),
                z: v
            )
        ),
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => radius,
            formula: u => v => Vector(
                x: v * cos(rad: u),
                y: v * sin(rad: u),
                z: 0.0
            )
        ),
        Surface2D(
            max_u: 2.0 * pi,
            min_v: u => 0.0, max_v: u => radius,
            formula: u => v => Vector(
                x: v * cos(rad: u),
                y: v * sin(rad: u),
                z: head_height
            )
        )
    ]),
    expose: {
        up: Vector(x: 0.0, y: 0.0, z: 1.0),
        right: Vector(x: 1.0, y: 0.0, z: 0.0),
        bottom: Vector(x: 0.0, y: 0.0, z: 0.0)
    }
)

def M3Screw = Component(
    solid: join(frame: Head, placed: Shaft, using: frame => placed => align(
        planar: meet(frame: frame.up, placed: placed.up),
        translation: meet(frame: frame.bottom + Vector(x: 0.0, y: 0.0, z: overlap), placed: placed.top),
        rotation: meet(frame: frame.right, placed: placed.right)
    ), combine: frame => placed => frame + placed),
    expose: {}
)

export(M3Screw)
